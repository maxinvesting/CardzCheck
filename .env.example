# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Stripe (PR C2b two-tier model) ---
# Post-collapse there are two paid tiers: CardzCheck Business and
# CardzCheck Business Pro. Until the new Stripe products are created, the
# checkout route falls back to the legacy variables below.
#
# Preferred (to be created in Stripe):
STRIPE_BUSINESS_BASIC_PRICE_ID=price_xxx         # CardzCheck Business monthly
STRIPE_BUSINESS_BASIC_ANNUAL_PRICE_ID=price_xxx  # CardzCheck Business annual (optional)
STRIPE_BUSINESS_PRO_MONTHLY_PRICE_ID=price_xxx   # CardzCheck Business Pro monthly
STRIPE_BUSINESS_PRO_ANNUAL_PRICE_ID=price_xxx    # CardzCheck Business Pro annual (optional)
#
# Legacy (back-compat — checkout falls back here if the new vars are unset):
STRIPE_ACTIVATION_PRICE_ID=price_xxx     # $20 one-time activation fee (monthly only)
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx   # legacy monthly "Pro" → treated as Business
STRIPE_ANNUAL_PRICE_ID=price_xxx         # legacy annual price (falls back to STRIPE_SUBSCRIPTION_PRICE_ID)
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_xxx  # legacy "Business" → Business Pro fallback
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_xxx   # legacy annual Business price (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# eBay (OAuth for Business — list items, orders, webhooks)
# Create an app at https://developer.ebay.com — use Production keys for live selling.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional if NEXT_PUBLIC_APP_URL is set: defaults to {NEXT_PUBLIC_APP_URL}/api/auth/ebay/callback
# Must match a RuName redirect URL configured on the eBay app exactly.
EBAY_REDIRECT_URI=
EBAY_VERIFICATION_TOKEN=  # eBay webhook endpoint verification token
# EBAY_ENVIRONMENT=sandbox   # Uncomment for Sandbox API hosts only

# Cron Protection
CRON_SECRET=your-secret-here  # Used to protect cron endpoints

# Rate Limiting (Upstash Redis — required for distributed rate limiting across Vercel instances)
# Create a free Redis database at https://console.upstash.com
# Without these, rate limiting falls back to per-instance in-memory (fine for local dev, not production)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Test Mode (bypasses authentication and payment checks)
# NEVER set this to true in production — it disables all auth and feature gating
NEXT_PUBLIC_TEST_MODE=false

# Upstash Redis — required for distributed rate limiting across Vercel instances
# Without this, rate limiting is in-memory only and bypassed by hitting different nodes.
# Create a free Serverless Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Grading labels + calibrator runtime
NEXT_PUBLIC_ENABLE_GRADING_LABELS=false
ENABLE_GRADING_LABELS=false
GRADE_CALIBRATOR_CACHE_TTL_MS=120000

# Internal admin bootstrap access (owner fallback before DB roles are assigned)
# Set to your email address — this grants owner access before app_role column is populated
ADMIN_EMAILS=
OWNER_EMAIL=

# PSA Card API — cert auto-population in Add/Edit card flows
# Get a token at https://www.psacard.com/api
PSA_ACCESS_TOKEN=
# Optional: some server paths also accept PSA_API_TOKEN if set instead
# PSA_API_TOKEN=

# Optional PSA slab image provider — used by async cert image resolution jobs
# TCGAPIs docs: https://tcgapis.com/psa-checker
TCGAPIS_API_KEY=
# Optional override for tests/self-hosted proxying. Defaults to https://api.tcgapis.com/api/v1
# TCGAPIS_BASE_URL=
