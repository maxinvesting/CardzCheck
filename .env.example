# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACTIVATION_PRICE_ID=price_xxx  # $20 one-time activation fee (monthly only)
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx  # monthly recurring price
STRIPE_ANNUAL_PRICE_ID=price_xxx  # annual recurring price (falls back to STRIPE_SUBSCRIPTION_PRICE_ID if unset)
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_xxx  # Business seats graduated price: seat 1 = $29/mo, seats 2+ = $12/mo each
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_xxx   # Legacy annual Business price (optional, legacy subscribers only)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# eBay (OAuth for Business — connect seller account)
EBAY_CLIENT_ID=           # From eBay Developer Program app
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=        # e.g. https://your-domain.com/api/auth/ebay/callback
EBAY_VERIFICATION_TOKEN=  # eBay webhook endpoint verification token

# Cron Protection
CRON_SECRET=your-secret-here  # Used to protect cron endpoints

# Test Mode (bypasses authentication and payment checks)
# NEVER set NEXT_PUBLIC_TEST_MODE=true in production — it is blocked by code guard regardless
NEXT_PUBLIC_TEST_MODE=false

# Upstash Redis — required for distributed rate limiting across Vercel instances
# Without this, rate limiting is in-memory only and bypassed by hitting different nodes.
# Create a free Serverless Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Grading labels + calibrator runtime
NEXT_PUBLIC_ENABLE_GRADING_LABELS=false
ENABLE_GRADING_LABELS=false
GRADE_CALIBRATOR_CACHE_TTL_MS=120000

# Internal admin bootstrap access (owner fallback before DB roles are assigned)
# Set to your email address — this grants owner access before app_role column is populated
ADMIN_EMAILS=
OWNER_EMAIL=

# PSA Card API — cert auto-population in Add/Edit card flows
# Get a token at https://www.psacard.com/api
PSA_ACCESS_TOKEN=
